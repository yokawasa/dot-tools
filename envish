#!/usr/bin/env bash
# Usage: source envish <envfile>
#   or:  . envish <envfile>
# Reads KEY=VALUE lines from <envfile> and exports them as environment variables.
# Lines starting with '#' and blank lines are ignored.

# envish を直接実行する場合、子プロセスで環境変数を設定しても親シェルには反映されない。
# これを解決するための一般的なアプローチとして source コマンドを使用している


envish() {
  local file="${1}"

  if [[ -z "$file" ]]; then
    echo "Usage: source envish <envfile>" >&2
    return 1
  fi

  if [[ ! -f "$file" ]]; then
    echo "envish: file not found: $file" >&2
    return 1
  fi

  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    # skip blank lines and comments
    [[ -z "$line" || "$line" == \#* ]] && continue

    # must contain '='
    [[ "$line" != *=* ]] && continue

    key="${line%%=*}"
    value="${line#*=}"

    # skip if key contains whitespace or is empty
    [[ -z "$key" || "$key" == *[[:space:]]* ]] && continue

    export "$key=$value"
    echo "export $key=***"
  done < "$file"
}

# Allow sourcing: if this script is sourced directly (not via a function call),
# define the function in the caller's shell.
# If executed directly, print a reminder.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "envish: this script must be sourced to affect the current shell." >&2
  echo "  Usage: source ${BASH_SOURCE[0]} <envfile>" >&2
  exit 1
fi
